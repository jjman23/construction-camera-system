{% extends "admin/base.html.twig" %}

{% block title %}{{ is_edit ? 'Edit' : 'Add' }} MikroTik - Construction Camera Admin{% endblock %}
{% block page_title %}{{ is_edit ? 'Edit MikroTik' : 'Add MikroTik' }}{% endblock %}

{% block page_actions %}
    <a href="{{ path('admin_mikrotik') }}" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Back to MikroTik Links
    </a>
{% endblock %}

{% block content %}
<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow">
            <div class="card-header">
                <h6 class="m-0 font-weight-bold text-primary">
                    <i class="bi bi-router"></i> {{ is_edit ? device.name : 'New wifi station' }}
                </h6>
            </div>
            <div class="card-body">
                <form method="post" autocomplete="off">
                    <input type="hidden" name="_token" value="{{ csrf_token('mikrotik_form') }}">

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="name" class="form-label">Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="name" name="name" required
                                   value="{{ device.name }}" placeholder="e.g., Gateway North SXT">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="building_id" class="form-label">Building</label>
                            <select class="form-select" id="building_id" name="building_id">
                                <option value="">— None —</option>
                                {% for b in buildings %}
                                    <option value="{{ b.id }}" {{ device.building and device.building.id == b.id ? 'selected' : '' }}>{{ b.name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="host" class="form-label">Host / IP <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="host" name="host" required
                                   value="{{ device.host }}" placeholder="203.0.113.10">
                        </div>
                        <div class="col-md-3 mb-3">
                            <label for="port" class="form-label">API port</label>
                            <input type="number" class="form-control" id="port" name="port" min="1" max="65535"
                                   value="{{ device.port }}">
                        </div>
                        <div class="col-md-3 mb-3 d-flex align-items-end">
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" id="use_ssl" name="use_ssl" value="1" {{ device.useSsl ? 'checked' : '' }}>
                                <label class="form-check-label" for="use_ssl">api-ssl</label>
                            </div>
                        </div>
                    </div>
                    <div class="form-text mt-n2 mb-3">RouterOS v6 API: <code>api</code> on 8728, or <code>api-ssl</code> on 8729. Limit access with <code>/ip service set api address=&lt;this server's IP&gt;</code>.</div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="username" class="form-label">API username <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="username" name="username" required
                                   value="{{ device.username }}" autocomplete="off">
                            <div class="form-text">A read-only user (group <code>read</code>, with <code>api</code> policy) is enough.</div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="password" class="form-label">Password</label>
                            <input type="password" class="form-control" id="password" name="password" autocomplete="new-password"
                                   placeholder="{{ is_edit ? 'Leave blank to keep current' : '' }}">
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="wireless_interface" class="form-label">Wireless interface</label>
                            <input type="text" class="form-control" id="wireless_interface" name="wireless_interface"
                                   value="{{ device.wirelessInterface }}" placeholder="All (e.g. wlan1)">
                            <div class="form-text">Optional. Only report this interface's registration table.</div>
                        </div>
                        {% if is_edit %}
                        <div class="col-md-6 mb-3 d-flex align-items-center">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="active" name="active" value="1" {{ device.active ? 'checked' : '' }}>
                                <label class="form-check-label" for="active">Active (include in scheduled polling)</label>
                            </div>
                        </div>
                        {% endif %}
                    </div>

                    <div class="mb-3">
                        <label for="notes" class="form-label">Notes</label>
                        <textarea class="form-control" id="notes" name="notes" rows="2">{{ device.notes }}</textarea>
                    </div>

                    <div class="border-top pt-3 d-flex justify-content-between">
                        <a href="{{ path('admin_mikrotik') }}" class="btn btn-secondary"><i class="bi bi-x"></i> Cancel</a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-{{ is_edit ? 'check' : 'plus' }}"></i> {{ is_edit ? 'Update' : 'Add MikroTik' }}
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
document.getElementById('use_ssl').addEventListener('change', function () {
    const port = document.getElementById('port');
    if (this.checked && port.value === '8728') port.value = '8729';
    if (!this.checked && port.value === '8729') port.value = '8728';
});
</script>
{% endblock %}
